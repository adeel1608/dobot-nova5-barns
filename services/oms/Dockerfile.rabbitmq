FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy shared modules
COPY shared/ /app/shared/

# Copy OMS service
COPY services/oms/ /app/services/oms/

# Set Python path
ENV PYTHONPATH=/app

# Expose port (not used for RabbitMQ but kept for compatibility)
EXPOSE 8000

# Run the updated OMS service with RabbitMQ integration
CMD ["python", "-m", "services.oms.app"] 