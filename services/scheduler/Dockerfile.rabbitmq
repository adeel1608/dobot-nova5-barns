FROM python:3.10-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements (service-local)
COPY services/scheduler/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r ./requirements.txt

# Copy shared modules
COPY shared/ /app/shared/

# Copy scheduler service
COPY services/scheduler/ /app/services/scheduler/

# Set Python path
ENV PYTHONPATH=/app

# Expose port (not used for RabbitMQ but kept for compatibility)
EXPOSE 8000

# Run the RabbitMQ-based scheduler service
CMD ["python", "-m", "services.scheduler.app"] 