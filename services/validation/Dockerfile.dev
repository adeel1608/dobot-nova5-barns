FROM python:3.10-slim

WORKDIR /app

# Install system dependencies for OpenCV and computer vision
RUN apt-get update && apt-get install -y \
    gcc \
    libgl1-mesa-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    libgthread-2.0-0 \
    libfontconfig1 \
    libxcb1 \
    && rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies only
COPY services/validation/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip
RUN pip install --no-cache-dir -r ./requirements.txt

# Set Python path
ENV PYTHONPATH=/app

# Expose port (not used for RabbitMQ but kept for compatibility)
EXPOSE 8000

# Run the RabbitMQ-based validation service
# Source code will be mounted as volume
CMD ["python", "-m", "services.validation.app"]

