# Build stage
FROM node:18-alpine as build

WORKDIR /app

# Copy package files
COPY services/barns-dashboard/package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY services/barns-dashboard/ .

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built application
COPY --from=build /app/dist /usr/share/nginx/html

# Copy RabbitMQ-compatible nginx configuration
COPY services/barns-dashboard/nginx.rabbitmq.conf /etc/nginx/conf.d/default.conf

# Copy entrypoint script
COPY services/barns-dashboard/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Expose port
EXPOSE 80

# Start via entrypoint
ENTRYPOINT ["/app/entrypoint.sh"]
 