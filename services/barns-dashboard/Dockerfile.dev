# Development stage for barns-dashboard
FROM node:18-alpine

WORKDIR /app

# Copy package files and install dependencies only
COPY services/barns-dashboard/package*.json ./
RUN npm install

# Expose Vite dev server port
EXPOSE 5173

# Start development server with hot reload
# Source code will be mounted as volume
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

