FROM ubuntu:22.04

# Prevent interactive prompts during build
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=UTC

# Set up locales
RUN apt-get update && apt-get install -y locales && \
    locale-gen en_US en_US.UTF-8 && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8

# Install basic utilities and dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    software-properties-common \
    curl \
    ca-certificates \
    git \
    lsb-release \
    wget \
    gnupg2 \
    sudo \
    udev \
    usbutils \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

# Set ROS distribution
ENV ROS_DISTRO=humble

# Add ROS 2 repository
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
    -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
    http://packages.ros.org/ros2/ubuntu $(. /etc/os-release && echo $UBUNTU_CODENAME) main" \
    > /etc/apt/sources.list.d/ros2.list

# Install ROS 2 Humble
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ros-base \
    && rm -rf /var/lib/apt/lists/*

# Install build tools and Python dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    && rm -rf /var/lib/apt/lists/*

# Install ROS 2 packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-${ROS_DISTRO}-ros2-control \
    ros-${ROS_DISTRO}-ros2-controllers \
    ros-${ROS_DISTRO}-moveit \
    ros-${ROS_DISTRO}-image-transport \
    ros-${ROS_DISTRO}-image-transport-plugins \
    ros-${ROS_DISTRO}-compressed-image-transport \
    ros-${ROS_DISTRO}-camera-info-manager \
    ros-${ROS_DISTRO}-diagnostic-updater \
    ros-${ROS_DISTRO}-diagnostic-msgs \
    ros-${ROS_DISTRO}-statistics-msgs \
    ros-${ROS_DISTRO}-tf-transformations \
    ros-${ROS_DISTRO}-kinematics-interface-kdl \
    ros-${ROS_DISTRO}-ros-testing \
    ros-${ROS_DISTRO}-launch-testing \
    ros-${ROS_DISTRO}-launch-testing-ament-cmake \
    ros-${ROS_DISTRO}-image-publisher \
    ros-${ROS_DISTRO}-backward-ros \
    && rm -rf /var/lib/apt/lists/*

# Initialize rosdep
RUN rosdep init && rosdep update

# Set up workspace directory
ENV WORKSPACE_DIR=/opt/barns-robot/ros_ws
RUN mkdir -p ${WORKSPACE_DIR}/src

# Copy workspace source files
COPY services/robot_container/ros_ws/src ${WORKSPACE_DIR}/src/
COPY shared ${WORKSPACE_DIR}/src/shared/

# Clone OrbbecSDK_ROS2 if not already present
RUN if [ ! -d "${WORKSPACE_DIR}/src/OrbbecSDK_ROS2" ]; then \
    cd ${WORKSPACE_DIR}/src && \
    git clone https://github.com/orbbec/OrbbecSDK_ROS2.git; \
    fi

# Install OrbbecSDK libraries with proper symlinks and ldconfig registration
RUN echo "Setting up OrbbecSDK libraries..." && \
    ARCH=$(uname -m) && \
    echo "Detected architecture: $ARCH" && \
    if [ "$ARCH" = "x86_64" ]; then \
        SDK_LIB_DIR="${WORKSPACE_DIR}/src/OrbbecSDK_ROS2/orbbec_camera/SDK/lib/x64"; \
    elif [ "$ARCH" = "aarch64" ]; then \
        SDK_LIB_DIR="${WORKSPACE_DIR}/src/OrbbecSDK_ROS2/orbbec_camera/SDK/lib/arm64"; \
    else \
        SDK_LIB_DIR="${WORKSPACE_DIR}/src/OrbbecSDK_ROS2/orbbec_camera/SDK/lib/arm32"; \
    fi && \
    echo "SDK_LIB_DIR=$SDK_LIB_DIR" && \
    if [ -d "$SDK_LIB_DIR" ]; then \
        echo "Found SDK directory, listing contents:" && \
        ls -lh "$SDK_LIB_DIR" && \
        echo "Copying SDK libraries to /usr/local/lib..." && \
        cp -v "$SDK_LIB_DIR"/*.so* /usr/local/lib/ && \
        echo "Creating symlinks..." && \
        cd /usr/local/lib && \
        ls -lh libOrbbecSDK* libdepthengine* && \
        ln -sf libOrbbecSDK.so.1.10.27 libOrbbecSDK.so && \
        ln -sf libOrbbecSDK.so.1.10.27 libOrbbecSDK.so.1 && \
        ln -sf libdepthengine.so.2.0 libdepthengine.so && \
        echo "Verifying symlinks:" && \
        ls -lh libOrbbecSDK.so* libdepthengine.so* && \
        echo "Registering /usr/local/lib with ldconfig..." && \
        echo "/usr/local/lib" > /etc/ld.so.conf.d/orbbec.conf && \
        ldconfig && \
        echo "SDK libraries setup complete" && \
        ldconfig -p | grep -i orbbec || echo "Warning: checking ldconfig cache"; \
    else \
        echo "ERROR: SDK lib directory not found at $SDK_LIB_DIR" && \
        ls -lh "${WORKSPACE_DIR}/src/OrbbecSDK_ROS2/orbbec_camera/SDK/lib/" && \
        exit 1; \
    fi

# Install additional APT dependencies from install script
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgflags-dev \
    nlohmann-json3-dev \
    libdw-dev \
    libomp-dev \
    freeglut3-dev \
    libgoogle-glog-dev \
    libusb-1.0-0-dev \
    libudev-dev \
    libeigen3-dev \
    libopencv-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN python3 -m pip install --no-cache-dir --upgrade pip && \
    python3 -m pip install --no-cache-dir \
    opencv-contrib-python==4.10.0.84 \
    numpy==1.23.5 \
    scipy==1.11.4 \
    transformations==2025.1.1 \
    aio-pika==9.4.3 \
    pika==1.3.2 \
    pyorbbecsdk==1.3.2

# Create python symlink
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Install ROS dependencies using rosdep
RUN cd ${WORKSPACE_DIR} && \
    bash -c "set +u && source /opt/ros/${ROS_DISTRO}/setup.bash && set -u && \
    rosdep install --from-paths src --ignore-src -y --rosdistro ${ROS_DISTRO}" || \
    echo "Some rosdep dependencies may have failed, continuing..."

# Build ROS workspace to pre-compile all packages
RUN cd ${WORKSPACE_DIR} && \
    bash -c "set +u && source /opt/ros/${ROS_DISTRO}/setup.bash && set -u && \
    colcon build --symlink-install \
        --cmake-args -DCMAKE_BUILD_TYPE=Release \
        --parallel-workers 2 \
        --event-handlers console_direct+ \
        --packages-skip-build-finished" || \
    (echo 'Build had errors but checking if critical packages built...' && \
     if [ -f 'install/setup.bash' ]; then \
         echo 'Core packages built successfully'; \
         exit 0; \
     else \
         echo 'ERROR: Critical build failure - install/setup.bash not found'; \
         exit 1; \
     fi)

# Install udev rules for Orbbec cameras
RUN if [ -f "${WORKSPACE_DIR}/src/OrbbecSDK_ROS2/orbbec_camera/scripts/install_udev_rules.sh" ]; then \
    cd ${WORKSPACE_DIR}/src/OrbbecSDK_ROS2/orbbec_camera/scripts && \
    bash install_udev_rules.sh || true; \
    fi

# Copy startup script
COPY robot1-startup.sh /opt/barns-robot/
RUN chmod +x /opt/barns-robot/robot1-startup.sh

# Create environment setup script
RUN echo '#!/bin/bash\n\
set +u\n\
source /opt/ros/${ROS_DISTRO}/setup.bash\n\
source ${WORKSPACE_DIR}/install/setup.bash\n\
set -u\n\
export PYTHONPATH="${WORKSPACE_DIR}/src:${WORKSPACE_DIR}/../../:${PYTHONPATH:-}"\n\
export DISPLAY=${DISPLAY:-:99}\n\
export QT_QPA_PLATFORM=offscreen\n\
export ROS_LOG_LEVEL=WARN\n\
export RCUTILS_LOGGING_SEVERITY_THRESHOLD=WARN\n\
export ROS_DISABLE_LOANED_MESSAGES=1\n\
export MOVEIT_DISABLE_GUI=1\n\
export RVIZ_DISABLE=1\n\
export AMENT_TRACE_SETUP_FILES=0\n\
export AMENT_PYTHON_EXECUTABLE=python3\n\
export LD_LIBRARY_PATH="/usr/local/lib:${LD_LIBRARY_PATH:-}"\n\
' > ${WORKSPACE_DIR}/setup_robot_env.sh && chmod +x ${WORKSPACE_DIR}/setup_robot_env.sh

# Environment variables for Robot 1
ENV ROBOT_ID=1
ENV ROS_DOMAIN_ID=0
ENV DOBOT_TYPE=nova5
ENV IP_ADDRESS=192.168.200.249
ENV CAMERA_SERIAL_NUMBER=CP1Z842000YW
ENV CAM_NAME=cam0
ENV DEVICE_ID=1
ENV DEVICE_NUM=1
ENV ORBBEC_CONNECTION_DELAY=3000
ENV USBFS_MEMORY_MB=128

# RabbitMQ connection (will be overridden by K8s)
ENV RABBITMQ_URL=amqp://admin:admin123@rabbitmq:5672/

# Set working directory
WORKDIR ${WORKSPACE_DIR}

# Entrypoint
CMD ["/bin/bash", "-c", "source ${WORKSPACE_DIR}/setup_robot_env.sh && /opt/barns-robot/robot1-startup.sh robot-only"]