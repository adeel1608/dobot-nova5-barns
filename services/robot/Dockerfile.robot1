FROM ros:humble-ros-base-jammy

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential git curl wget ca-certificates udev usbutils \
    python3-pip python3-colcon-common-extensions python3-rosdep \
    xvfb libgtk-3-0 libgl1-mesa-glx libglib2.0-0 libsm6 libxrender1 libxext6 dos2unix \
    ros-humble-ros2-control ros-humble-ros2-controllers ros-humble-moveit \
    ros-humble-image-transport ros-humble-image-transport-plugins \
    ros-humble-compressed-image-transport ros-humble-camera-info-manager \
    ros-humble-diagnostic-updater ros-humble-diagnostic-msgs ros-humble-statistics-msgs \
    ros-humble-tf-transformations ros-humble-kinematics-interface-kdl \
    ros-humble-ros-testing ros-humble-launch-testing ros-humble-launch-testing-ament-cmake \
    ros-humble-image-publisher ros-humble-backward-ros \
    libgflags-dev nlohmann-json3-dev libdw-dev libomp-dev freeglut3-dev libgoogle-glog-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN python3 -m pip install --upgrade pip && \
    pip install --no-cache-dir \
    opencv-contrib-python==4.10.0.84 numpy==1.23.5 scipy==1.11.4 \
    transformations==2025.1.1 aio-pika==9.4.3 pika==1.3.2

# Create python symlink
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Initialize rosdep
RUN rosdep update || true

# Build ROS workspace
WORKDIR /opt/ros_ws
COPY services/robot_container/ros_ws/src ./src
COPY shared ./src/shared

RUN . /opt/ros/humble/setup.sh && \
    rosdep install --from-paths src --ignore-src -r -y || true && \
    colcon build --symlink-install --packages-skip orbbec_camera --cmake-args -DCMAKE_BUILD_TYPE=Release

# Copy robot startup script
COPY robot1-startup.sh /opt/robot1-startup.sh
RUN chmod +x /opt/robot1-startup.sh && dos2unix /opt/robot1-startup.sh 2>/dev/null || true

# Environment variables
ENV ROS_DISTRO=humble \
    WORKSPACE_DIR=/opt/ros_ws \
    RABBITMQ_URL=amqp://admin:admin123@rabbitmq.barns.svc.cluster.local:5672/ \
    ROBOT_ID=1 \
    DOBOT_TYPE=nova5 \
    IP_ADDRESS=192.168.200.249 \
    ROS_DOMAIN_ID=0 \
    CAMERA_SERIAL_NUMBER=CP1Z842000YW \
    CAM_NAME=cam0 \
    DEVICE_ID=1 \
    DEVICE_NUM=1 \
    ORBBEC_CONNECTION_DELAY=3000 \
    USBFS_MEMORY_MB=128 \
    DISPLAY=:99 \
    QT_QPA_PLATFORM=offscreen \
    ROS_LOG_LEVEL=WARN \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /opt/ros_ws

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD pgrep -f "robot1-startup.sh" || exit 1

CMD ["/bin/bash", "-c", "source /opt/ros/humble/setup.bash && source /opt/ros_ws/install/setup.bash && /opt/robot1-startup.sh robot-only"]
