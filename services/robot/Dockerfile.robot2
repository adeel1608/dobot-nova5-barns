FROM ros:humble-ros-base-jammy AS base

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV ROS_DISTRO=humble

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    curl \
    wget \
    ca-certificates \
    udev \
    usbutils \
    python3-pip \
    python3-colcon-common-extensions \
    python3-rosdep \
    net-tools \
    iputils-ping \
    iproute2 \
    openssh-client \
    lsb-release \
    software-properties-common \
    xvfb \
    libgtk-3-0 \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libsm6 \
    libxrender1 \
    libxext6 \
    && rm -rf /var/lib/apt/lists/*

# Install ROS 2 packages
RUN apt-get update && apt-get install -y \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-moveit \
    ros-humble-image-transport \
    ros-humble-image-transport-plugins \
    ros-humble-compressed-image-transport \
    ros-humble-camera-info-manager \
    ros-humble-diagnostic-updater \
    ros-humble-diagnostic-msgs \
    ros-humble-statistics-msgs \
    ros-humble-tf-transformations \
    ros-humble-kinematics-interface-kdl \
    ros-humble-ros-testing \
    ros-humble-launch-testing \
    ros-humble-launch-testing-ament-cmake \
    ros-humble-image-publisher \
    ros-humble-backward-ros \
    && rm -rf /var/lib/apt/lists/*

# Install OrbbecSDK specific dependencies
RUN apt-get update && apt-get install -y \
    libgflags-dev \
    nlohmann-json3-dev \
    libdw-dev \
    libomp-dev \
    freeglut3-dev \
    libgoogle-glog-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN python3 -m pip install --upgrade pip && \
    pip install --no-cache-dir \
    opencv-contrib-python==4.10.0.84 \
    numpy==1.23.5 \
    scipy==1.11.4 \
    transformations==2025.1.1 \
    aio-pika==9.4.3 \
    pika==1.3.2

# Create python symlink
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Initialize rosdep
RUN rosdep update || true

# Builder stage - build ROS workspace
FROM base AS builder

WORKDIR /opt/ros_ws

# Copy ROS workspace source
COPY services/robot_container/ros_ws/src ./src

# Copy shared module
COPY shared ./src/shared

# Install workspace dependencies using rosdep
RUN . /opt/ros/humble/setup.sh && \
    rosdep install --from-paths src --ignore-src -r -y || true

# Build the workspace
RUN . /opt/ros/humble/setup.sh && \
    colcon build --symlink-install --cmake-args -DCMAKE_BUILD_TYPE=Release

# Final runtime stage
FROM base AS runtime

# Copy built workspace from builder
COPY --from=builder /opt/ros_ws /opt/ros_ws

# Copy robot startup script
COPY robot2-startup.sh /opt/robot2-startup.sh
RUN chmod +x /opt/robot2-startup.sh

# Set working directory
WORKDIR /opt

# Environment variables for Robot 2
ENV WORKSPACE_DIR=/opt/ros_ws
ENV ROBOT_ID=2
ENV DOBOT_TYPE=nova5
ENV IP_ADDRESS=192.168.200.248
ENV ROS_DOMAIN_ID=1
ENV CAMERA_SERIAL_NUMBER=CP1Z842000F6
ENV CAM_NAME=cam1
ENV DEVICE_ID=2
ENV DEVICE_NUM=2
ENV ORBBEC_CONNECTION_DELAY=3000
ENV USBFS_MEMORY_MB=128

# Source ROS environment in bashrc
RUN echo "source /opt/ros/\/setup.bash" >> /root/.bashrc && \
    echo "source /opt/ros_ws/install/setup.bash" >> /root/.bashrc

# Health check - verify the script process is running
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD pgrep -f robot2-startup.sh || exit 1

# Entrypoint sources ROS and runs the startup script
CMD ["/bin/bash", "-c", "source /opt/ros/\/setup.bash && source /opt/ros_ws/install/setup.bash && /opt/robot2-startup.sh"]
