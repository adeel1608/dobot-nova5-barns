{
    "drink": "Latte",
    "steps": [
      {
        "name": "Check cup placement",
        "validation_function": "check_cup_present",
        "parameters": { },
        "run_validation_first": true
      },
      {
        "name": "Grind coffee beans",
        "robotic_function": "grind_beans",
        "validation_function": "check_beans", 
        "parameters": { "grams": 18 },
        "run_validation_first": true
      },
      {
        "name": "Tamp coffee grounds",
        "robotic_function": "tamp_ground",
        "parameters": { }
      },
      {
        "name": "Brew espresso shot",
        "robotic_function": "brew_espresso",
        "validation_function": "check_weight",
        "parameters": { "min_weight": 30 }
        /* After brewing, check_weight validation ensures at least 30g of espresso in cup */
      },
      {
        "name": "Steam milk",
        "robotic_function": "steam_milk",
        "validation_function": "check_temperature",
        "parameters": { "min_temp": 60 }
        /* Check milk reaches at least 60°C */
      },
      {
        "name": "Pour milk into cup",
        "robotic_function": "pour_milk",
        "parameters": { "amount_ml": 150 }
      }
    ]
  }
  