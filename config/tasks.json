  "Espresso_single_shot": {
    "steps": [
      {
        "type": "automation",
        "function": "grinding_machine",
        "params": {
          "shots_number": 1
        }
      },
      {
        "type": "robot",
        "function": "unmount",
        "params": {
          "port": "port_1"
        }
      },
      {
        "type": "robot",
        "function": "grinder",
        "params": {
          "portafilter_tool": "single_portafilter"
        }
      },
      {
        "type": "automation",
        "function": "tampering_machine",
        "params": {
          "tampering": 1
        }
      },
      {
        "type": "robot",
        "function": "tamper",
        "params": {
          "portafilter_tool": "single_portafilter"
        }
      },
      {
        "type": "robot",
        "function": "mount",
        "params": {
          "port": "port_1"
        }
      },
      {
        "type": "automation",
        "function": "coffee_machine",
        "params": {
          "coffee_t": 1,
          "slot_number": 1
        }
      },
      {
        "type": "robot",
        "function": "grab_paper_cup",
        "params": {
          "size": "7oz"
        }
      },
      {
        "type": "robot",
        "function": "place_paper_cup",
        "params": {
          "stage": "stage_1"
        }
      },
      {
        "type": "robot",
        "function": "pick_espresso_pitcher",
        "params": {
          "port": "port_1"
        }
      }      
    ]
  },
